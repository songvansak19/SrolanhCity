# SrolanhCity Backend Configuration
APP_NAME=SrolanhCity API
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# PostgreSQL 16 + PostGIS 3.4
DATABASE_URL=postgresql+asyncpg://srolanhcity:srolanhcity@localhost:5432/srolanhcity

# Redis 7
REDIS_URL=redis://localhost:6379/0

# MinIO (local) / Cloudflare R2 (production S3-compatible)
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=srolanhcity-media
S3_REGION=auto

# Server-side Gemini AI Proxy
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Auth (PyJWT)
JWT_SECRET_KEY=change-me-in-production-use-32-plus-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS (includes live GitHub Pages Web PWA origin)
CORS_ORIGINS=["https://songvansak19.github.io","http://localhost:3000","http://localhost:8080"]

# Integrity & Offline Modes
INTEGRITY_MODE=development
OFFLINE_STUB_DB=false
